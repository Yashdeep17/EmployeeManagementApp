@page
@model EmployeeManagementApp.Areas.Identity.Pages.Account.VerifyOTPModel
@{
    ViewData["Title"] = "Verify Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="bg-dark d-flex align-items-center justify-content-center vh-100 overflow-hidden m-0 p-0">

    <div class="shadow-lg" style="width: 90vw; max-width: 1000px; height: 80vh; max-height: 700px; background-color: #dcedc8; border-radius: 40px; padding: 1.5rem;">
        <div class="row g-0 h-100 w-100">

            <div class="col-lg-6 d-none d-lg-block h-100 p-2 p-md-3">
                <img src="~/images/otp-bg.png" alt="Security Verification" style="width: 100%; height: 100%; object-fit: cover; border-radius: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            </div>

            <div class="col-lg-6 h-100 p-2 p-md-3">
                <div class="bg-white d-flex flex-column justify-content-center h-100 w-100 text-center" style="border-radius: 35px; padding: 2rem 3rem; box-shadow: -10px 10px 30px rgba(0,0,0,0.05);">

                    <div class="mb-4">
                        <div class="text-success fw-bold fs-6 mb-3 d-flex justify-content-center align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill"></i> Security Verification
                        </div>
                        <h1 class="fw-bold text-dark mb-2" style="font-size: 2.2rem; letter-spacing: -1px;">Enter Code</h1>
                        <p class="text-muted" style="font-size: 0.95rem;">
                            We sent a 6-digit verification code to<br />
                            <strong class="text-dark">@Model.Email</strong>
                        </p>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.9rem; text-align: left;"></div>

                        <div class="mb-4 px-md-4">
                            <input asp-for="OtpCode" class="form-control form-control-lg rounded-4 text-center fw-bold"
                                   style="border: 2px solid #8bc34a; font-size: 2rem; letter-spacing: 15px; padding: 1rem; background-color: #f8f9fa;"
                                   autocomplete="off" maxlength="6" placeholder="------" />
                            <span asp-validation-for="OtpCode" class="text-danger mt-2 d-block" style="font-size: 0.85rem;"></span>
                        </div>

                        <button type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm mb-3" style="background-color: #8bc34a; font-size: 1.1rem; border: none;">
                            Verify & Login
                        </button>
                    </form>

                </div>
            </div>

        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>