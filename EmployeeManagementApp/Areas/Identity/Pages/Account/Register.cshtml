@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="bg-dark d-flex align-items-center justify-content-center vh-100 overflow-hidden m-0 p-0">

    <div class="shadow-lg" style="width: 90vw; max-width: 1200px; height: 90vh; max-height: 800px; background-color: #dcedc8; border-radius: 40px; padding: 1.5rem;">

        <div class="row g-0 h-100 w-100">

            <div class="col-lg-6 d-none d-lg-block h-100 p-2 p-md-3">
                <img src="~/images/register-bg.jpg" alt="New Beginning Illustration" style="width: 100%; height: 100%; object-fit: cover; border-radius: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
            </div>

            <div class="col-lg-6 h-100 p-2 p-md-3">
                <div class="bg-white d-flex flex-column justify-content-center h-100 w-100" style="border-radius: 35px; padding: 2rem 3rem; box-shadow: -10px 10px 30px rgba(0,0,0,0.05); overflow-y: auto;">

                    <div class="text-center mb-4">
                        <div class="text-success fw-bold fs-6 mb-3 d-flex justify-content-center align-items-center gap-2">
                            <i class="bi bi-buildings-fill"></i> HR Portal
                        </div>
                        <h1 class="fw-bold text-dark mb-1" style="font-size: 2.5rem; letter-spacing: -1px;">Create<br>Account</h1>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <input asp-for="Input.Email" class="form-control form-control-lg rounded-pill px-4 py-3 bg-transparent" style="border: 2px solid #e0e0e0; font-size: 0.95rem;" autocomplete="username" aria-required="true" placeholder="Email address" />
                            <span asp-validation-for="Input.Email" class="text-danger ms-3 mt-1 d-block" style="font-size: 0.85rem;"></span>
                        </div>

                        <div class="mb-3">
                            <input asp-for="Input.Password" class="form-control form-control-lg rounded-pill px-4 py-3 bg-transparent" style="border: 2px solid #e0e0e0; font-size: 0.95rem;" autocomplete="new-password" aria-required="true" placeholder="Password" />
                            <span asp-validation-for="Input.Password" class="text-danger ms-3 mt-1 d-block" style="font-size: 0.85rem;"></span>
                        </div>

                        <div class="mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg rounded-pill px-4 py-3 bg-transparent" style="border: 2px solid #e0e0e0; font-size: 0.95rem;" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger ms-3 mt-1 d-block" style="font-size: 0.85rem;"></span>
                        </div>

                        <button id="registerSubmit" type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm mb-3" style="background-color: #8bc34a; font-size: 1.1rem; border: none;">
                            Sign Up
                        </button>

                        <div class="text-center mt-2">
                            <p class="text-muted mb-0" style="font-size: 0.9rem;">
                                Already have an account?
                                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-success fw-bold text-decoration-none ms-1">Log in</a>
                            </p>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>