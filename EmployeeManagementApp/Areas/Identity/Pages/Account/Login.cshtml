@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    // We set Layout to null so the top Navbar hides. We want a pure full-screen login!
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HR Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script>
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
    </script>
</head>
<body class="bg-dark d-flex align-items-center justify-content-center min-vh-100 p-3">

    <div class="container shadow-lg position-relative" style="max-width: 1100px; background-color: #dcedc8; border-radius: 40px; padding: 20px;">
        <div class="row g-0 align-items-stretch">

            <div class="col-lg-6 d-none d-lg-flex align-items-center justify-content-center p-4 p-xl-5">
                <img src="~/images/login-bg.jpg" alt="Workspace Illustration" class="img-fluid" style="border-radius: 30px; object-fit: cover; max-height: 650px; box-shadow: 0 20px 40px rgba(0,0,0,0.1);">
            </div>

            <div class="col-lg-6 p-2 p-md-3">
                <div class="bg-white d-flex flex-column justify-content-center h-100 w-100" style="border-radius: 35px; padding: 4rem 3rem; box-shadow: -10px 10px 30px rgba(0,0,0,0.05);">

                    <div class="text-center mb-5">
                        <div class="text-success fw-bold fs-5 mb-4 d-flex justify-content-center align-items-center gap-2">
                            <i class="bi bi-buildings-fill"></i> HR Portal
                        </div>

                        <h1 class="fw-bold text-dark mb-2" style="font-size: 2.8rem; letter-spacing: -1px;">Welcome<br>Back</h1>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-4">
                            <input asp-for="Input.Email" class="form-control form-control-lg rounded-pill px-4 py-3 bg-transparent" style="border: 2px solid #e0e0e0; font-size: 0.95rem;" autocomplete="username" aria-required="true" placeholder="Email address" />
                            <span asp-validation-for="Input.Email" class="text-danger ms-3 mt-1 d-block" style="font-size: 0.85rem;"></span>
                        </div>

                        <div class="mb-4">
                            <input asp-for="Input.Password" class="form-control form-control-lg rounded-pill px-4 py-3 bg-transparent" style="border: 2px solid #e0e0e0; font-size: 0.95rem;" autocomplete="current-password" aria-required="true" placeholder="Password" />
                            <span asp-validation-for="Input.Password" class="text-danger ms-3 mt-1 d-block" style="font-size: 0.85rem;"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 px-3">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label text-muted" asp-for="Input.RememberMe" style="font-size: 0.9rem;">
                                    Remember me
                                </label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-success text-decoration-none fw-semibold" style="font-size: 0.9rem;">Forgot password?</a>
                        </div>

                        <button id="login-submit" type="submit" class="btn w-100 rounded-pill py-3 fw-bold text-white shadow-sm mb-4" style="background-color: #8bc34a; font-size: 1.1rem; border: none;">
                            Log in
                        </button>

                        <div class="text-center mt-3">
                            <p class="text-muted" style="font-size: 0.9rem;">
                                Don't have an account?
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-success fw-bold text-decoration-none ms-1">Sign up</a>
                            </p>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>